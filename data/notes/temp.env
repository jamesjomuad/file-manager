# Basic settings
N8N_ENCRYPTION_KEY=0IsYfCeCY77UlJoi0YiRLVJx5AdHF2Ke
N8N_PROTOCOL=https
N8N_METRICS=true
NODE_FUNCTION_ALLOW_EXTERNAL=axios,moment,lodash,knex,mysql2

# URLs
WEBHOOK_URL=https://n8n.realresponse.com.au
VUE_APP_URL_BASE_API=https://n8n.realresponse.com.au/

# Database (Postgres)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=root

# Optional execution pruning
EXECUTIONS_DATA_PRUNE_MAX_COUNT=100

# Node.js memory limit
NODE_OPTIONS=--max-old-space-size=2048


EXECUTIONS_MODE=queue
N8N_RUNNERS_ENABLED=true
N8N_RUNNERS_MAX_CONCURRENT_WORKFLOWS=5
QUEUE_BULL_REDIS_HOST=127.0.0.1
QUEUE_BULL_REDIS_PORT=6379